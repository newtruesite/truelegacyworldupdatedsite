# ─── Supabase ───────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://huaoirkvzckqfowjsnnt.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
# New Supabase projects may label the same browser-safe key as Publishable.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-public-key-here

# ─── Training gate ──────────────────────────────────────────────────────────
# Secret code members must enter to unlock training content.
# Keep this out of version control. Set it in the environment-variable settings
# of whichever deployment provider is currently hosting the frontend.
VITE_SECRET_CODE=choose-a-separate-training-access-code

# ─── Notes ──────────────────────────────────────────────────────────────────
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For production, add the same variables in the active hosting provider's
# project settings. The application does not require a specific host.
#
# Do not add GoHighLevel or another CRM's private API token as a VITE_* variable.
# VITE_* values are shipped to the visitor's browser. Future CRM automation must
# be connected through a server-side function or webhook adapter.
#
# NEVER commit .env.local or real key values to git.
# The app degrades gracefully when these are missing (auth disabled, site renders).
